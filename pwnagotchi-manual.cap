# enable interface monitor mode and define wifi interface to be wlan0mon
set wifi.interface wlan0mon

# start logging to file
set events.stream.output /etc/pwnagotchi/log/bettercap-manu-session.log

# api listening on http://0.0.0.0:8081/ and ui to http://0.0.0.0
set api.rest.address 0.0.0.0
set api.rest.port 8081
set ui.address 0.0.0.0
set ui.port 80
set api.rest.username pwnagotchi
set api.rest.password pwnagotchi
set api.rest.websocket true


# go!
api.rest on
ui on
